#!/usr/bin/env sh

# Only reached when install.cjs didn't run (dev checkout, or an installer that
# skips postinstall) - otherwise the chosen binary has replaced this script.

# Get the directory of the script to work from.
DIR=$(dirname "$0")

if [ -f "$DIR/src/_build/default/bin/bin.exe" ]; then
    # Use the dev build
    exec "$DIR/src/_build/default/bin/bin.exe" "$@"
fi

case "$(uname -m)" in
    arm64 | aarch64) ARCH=-arm ;;
    x86_64 | amd64) ARCH= ;;
    *) echo "No release available for '$(uname -m)'" >&2; exit 1 ;;
esac

case "$(uname)" in
    Darwin) exec "$DIR/ppx-osx$ARCH.exe" "$@" ;;
    Linux) exec "$DIR/ppx-linux$ARCH.exe" "$@" ;;
    *) echo "No release available for '$(uname)'" >&2; exit 1 ;;
esac
