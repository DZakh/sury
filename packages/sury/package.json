{
  "name": "sury",
  "version": "11.0.0-rc.0",
  "private": true,
  "description": "🧬 The fastest schema with next-gen DX",
  "keywords": [
    "ReScript",
    "Schema",
    "Parser",
    "Serializer",
    "JSON",
    "Encode",
    "Decode",
    "Validation",
    "Contract",
    "TypeScript",
    "Zod",
    "Valibot",
    "Ajv",
    "rescript-struct"
  ],
  "homepage": "https://github.com/DZakh/sury#readme",
  "bugs": {
    "url": "https://github.com/DZakh/sury/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZakh/sury.git"
  },
  "license": "MIT",
  "author": "Dmitry Zakharov <dzakh.dev@gmail.com>",
  "type": "module",
  "sideEffects": [
    "./src/S.res.mjs",
    "./src/S.res.js"
  ],
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./src/*": "./src/*",
    "./S.gen.js": {
      "types": "./src/S.gen.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "coverage": "pnpm build:entry && vitest run --coverage",
    "spec": "pnpm build:entry && tsx ../spec/cli.ts",
    "build:entry": "tsx ./scripts/pack.ts entry-only",
    "fuzz:union": "tsx ./scripts/unionFuzz.ts",
    "bench:jsonstring": "pnpm build:entry && tsx ./scripts/jsonStringifyBench.ts",
    "bench:fjs": "pnpm build:entry && tsx ./scripts/fjsBench.ts",
    "build": "pnpm rescript && tsx ./scripts/pack.ts for-publish",
    "res": "pnpm build:entry && rescript watch",
    "test": "pnpm build && vitest run",
    "typecheck": "vitest run --typecheck.only",
    "lint:stdlib": "rescript-stdlib-vendorer lint --ignore-path=src",
    "prepublishOnly": "node -e \"console.error('Publish from ./artifacts (pnpm build), not the dev package.'); process.exit(1)\""
  },
  "devDependencies": {
    "@rescript/darwin-arm64": "12.2.0",
    "@rollup/plugin-node-resolve": "16.0.0",
    "@types/node": "20.19.41",
    "@vitest/coverage-v8": "4.1.7",
    "devalue": "^5.9.0",
    "effect": "4.0.0-rc.108",
    "esbuild": "0.28.1",
    "execa": "7.1.1",
    "fast-json-stringify": "^7.0.1",
    "rescript": "12.2.0",
    "rescript-stdlib-vendorer": "1.1.0",
    "rollup": "3.21.0",
    "superjson": "^2.2.6",
    "tinybench": "^6.1.2",
    "tsx": "4.22.4",
    "typescript": "5.8.3",
    "typia": "^13.2.0",
    "vitest": "4.1.7",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "rescript": "12.x"
  },
  "peerDependenciesMeta": {
    "rescript": {
      "optional": true
    }
  }
}
