{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "res": "pnpm --filter=sury exec rescript watch",
    "spec": "tsx packages/spec/cli.ts",
    "compliance": "pnpm --filter=sury build:entry && tsx packages/json-schema-test-suite/cli.ts",
    "protobuf:compliance": "pnpm --filter=sury build:entry && tsx packages/protobuf-test-suite/cli.ts",
    "test": "pnpm --filter=sury test && pnpm --filter=e2e test",
    "build": "pnpm --filter=sury build",
    "benchmark:comparison": "pnpm --filter=e2e benchmark:comparison",
    "lint": "pnpm --filter=sury lint:stdlib",
    "lint:deadcode": "knip"
  },
  "packageManager": "pnpm@9.0.5",
  "engines": {
    "node": "24.16.0"
  },
  "devDependencies": {
    "knip": "6.26.0"
  }
}
